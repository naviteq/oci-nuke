{{/*
template.go.tmpl -- the single source of truth for the resource contract every resources/*.go
file in this project must follow (04-RESEARCH.md Q1/Q8). Two named templates share this file:

  - "resource" renders the resource file itself: the narrow SDK client interface, the
    ocinuke.Register call (always via ocinuke.CurrentScope/ocinuke.CurrentReporter, never a
    locally-constructed closure -- see pkg/ocinuke/runcontext.go), the Lister, and the
    resource struct's GetCompartmentID/UniqueKey/Filter/Remove/Properties methods.
  - "test" renders the list/filter/remove test skeleton, parameterized on the SAME emitted
    stub client interface, isolated from pkg/clients.Cache so it never touches the network.

Both templates are rendered, then passed through go/format.Source before being written -- exact
whitespace in this file does not matter; only the resulting token stream does.
*/}}

{{define "resource"}}
// Package resources is blank-imported by main.go and pkg/commands/list to register every OCI
// resource type with libnuke's registry.
package resources

import (
	"context"
	"fmt"
	"time"

	"github.com/ekristen/libnuke/pkg/registry"
	"github.com/ekristen/libnuke/pkg/resource"
	"github.com/ekristen/libnuke/pkg/types"
	"github.com/oracle/oci-go-sdk/v65/{{.SDKPackage}}"

	"github.com/naviteq/oci-nuke/pkg/ocinuke"
)

// {{.ClientInterfaceName}} is the narrow slice of {{.SDKPackage}}.{{.ClientAccessor}}Client this lister needs -- a
// hand-written interface so {{.Name}} is stub-testable with zero network access. Every resource
// type gets its OWN narrow interface, scoped to exactly the calls it makes.
type {{.ClientInterfaceName}} interface {
	{{.ListMethod}}(ctx context.Context, req {{.SDKPackage}}.{{.ListMethod}}Request) ({{.SDKPackage}}.{{.ListMethod}}Response, error)
	{{.DeleteMethod}}(ctx context.Context, req {{.SDKPackage}}.{{.DeleteMethod}}Request) ({{.SDKPackage}}.{{.DeleteMethod}}Response, error)
}

// {{.ResourceTypeConst}} is the registry.Registration.Name for {{.Name}}.
const {{.ResourceTypeConst}} = "{{.Name}}"

func init() {
	ocinuke.Register(&registry.Registration{
		Name:     {{.ResourceTypeConst}},
		Scope:    ocinuke.CompartmentScope,
		Resource: &{{.Name}}{},
		Lister:   &{{.ListerTypeName}}{},
		{{- if .DependsOn}}
		DependsOn: []string{ {{range $i, $d := .DependsOn}}{{if $i}}, {{end}}"{{$d}}"{{end}} },
		{{- else}}
		// DependsOn is intentionally empty -- declare it on whichever type actually has the
		// dependency, never on the type depended upon (04-RESEARCH.md Q1).
		{{- end}}
	}, ocinuke.CurrentScope, ocinuke.CurrentReporter)
}

type {{.ListerTypeName}} struct{}

// List satisfies registry.Lister. The pagination/wrapping logic itself lives in
// {{.ListHelperName}}, kept separate so it is unit-testable against a stub client without ever
// constructing a real {{.ClientAccessor}} client.
func (l *{{.ListerTypeName}}) List(ctx context.Context, opts interface{}) ([]resource.Resource, error) {
	o, ok := opts.(*ocinuke.ListerOpts)
	if !ok {
		return nil, fmt.Errorf("{{.ListerTypeName}}.List: unexpected opts type %T", opts)
	}
	if err := o.BeforeList(ocinuke.Regional); err != nil {
		return nil, err
	}

	client, err := o.Clients.{{.ClientAccessor}}(o.Region)
	if err != nil {
		return nil, fmt.Errorf("constructing {{.ClientAccessor}}Client for %s: %w", o.Region, err)
	}

	return {{.ListHelperName}}(ctx, client, o.CompartmentID)
}

// {{.ListHelperName}} paginates {{.SDKPackage}}.{{.ListMethod}} and wraps every returned item as a {{.Name}}.
// Isolated from ocinuke.ListerOpts/pkg/clients.Cache on purpose -- this is what the list test
// below exercises against a stub, with zero network access.
func {{.ListHelperName}}(
	ctx context.Context,
	client {{.ClientInterfaceName}},
	compartmentID string,
) ([]resource.Resource, error) {
	var out []resource.Resource
	req := {{.SDKPackage}}.{{.ListMethod}}Request{ {{.ListRequestField}}: &compartmentID }
	for {
		resp, err := client.{{.ListMethod}}(ctx, req)
		if err != nil {
			return nil, fmt.Errorf("listing {{.Name}} in %s: %w", compartmentID, err)
		}
		for i := range resp.Items {
			out = append(out, &{{.Name}}{client: client, {{.FieldName}}: resp.Items[i]})
		}
		if resp.OpcNextPage == nil {
			break
		}
		req.Page = resp.OpcNextPage
	}
	return out, nil
}

// {{.Name}} wraps one {{.SDKPackage}}.{{.SDKType}}.
type {{.Name}} struct {
	client       {{.ClientInterfaceName}}
	{{.FieldName}} {{.SDKPackage}}.{{.SDKType}}
}

// GetCompartmentID satisfies ocinuke.CompartmentScoped -- mandatory, checked by ocinuke.Register
// at init() time (a missing implementation panics at process start, not at runtime).
func (r *{{.Name}}) GetCompartmentID() string { return *r.{{.FieldName}}.CompartmentId }

// UniqueKey satisfies resource.UniqueKeyGetter (SAFE-09) -- the OCID, never the display name.
// This is the ONLY safe identity key for a resource that can be recreated with the same name by
// Terraform drift-reconciliation mid-run (PITFALLS.md Pitfall 5).
func (r *{{.Name}}) UniqueKey() string { return *r.{{.FieldName}}.Id }

// Filter is called from TWO structurally different contexts (04-RESEARCH.md Q2): at scan time a
// non-nil return means "never attempt removal"; during HandleWait's post-Remove() polling, a
// non-nil return on a still-listed match means "already handled, converge now." Both meanings
// are satisfied by the same allow-list-of-"present" check -- any state not explicitly listed
// here excludes, so a future SDK release adding a new lifecycle-state value fails safe.
func (r *{{.Name}}) Filter() error {
	switch r.{{.FieldName}}.{{.LifecycleField}} {
	case {{join .LifecyclePresentConsts ", "}}:
		return nil
	default:
		return fmt.Errorf("{{.Name}} is %s, not available", r.{{.FieldName}}.{{.LifecycleField}})
	}
}

// SafetyTags satisfies ocinuke.SafetyEvaluated, returning this resource's freeform tags,
// its already-flattened ("<namespace>.<key>") defined tags, and its creation time -- the
// three values ocinuke.Evaluate needs beyond compartment/resource identity (both already
// available via GetCompartmentID/UniqueKey). Read by ocinuke's scopedLister at SCAN time,
// before this resource can ever become a queue.Item -- see pkg/ocinuke/scoped_lister.go's
// SafetyEvaluated doc comment for why protection moved here from Remove() (04-13 plan/apply
// divergence fix).
func (r *{{.Name}}) SafetyTags() (freeform, defined map[string]string, createdAt time.Time) {
	x := r.{{.FieldName}}
	return x.FreeformTags, flattenDefinedTags(x.DefinedTags), x.TimeCreated.Time
}

// Remove is a direct delete call -- protect-by-tag/min-age protection is now applied at SCAN
// time (SafetyTags above), before this resource can ever become a queue.Item, so a protected
// resource never reaches Remove() at all, in either dry-run or --no-dry-run mode.
func (r *{{.Name}}) Remove(ctx context.Context) error {
	x := r.{{.FieldName}}
	_, err := r.client.{{.DeleteMethod}}(ctx, {{.SDKPackage}}.{{.DeleteMethod}}Request{ {{.DeleteIDField}}: x.Id })
	return holdOn409(err)
}

// Properties exposes the filter vocabulary this type supports, built from resources/support.go's
// shared helper so no resource file hand-duplicates a property-key string literal.
func (r *{{.Name}}) Properties() types.Properties {
	x := r.{{.FieldName}}
	return baseProperties(x.Id, x.DisplayName, x.CompartmentId, string(x.{{.LifecycleField}}), x.TimeCreated, x.FreeformTags, x.DefinedTags){{range .ExtraProperties}}.
		Set({{.KeyExpr}}, x.{{.Field}}){{end}}
}
{{end}}

{{define "test"}}
package resources

import (
	"context"
	"testing"
	"time"

	"github.com/oracle/oci-go-sdk/v65/common"
	"github.com/oracle/oci-go-sdk/v65/{{.SDKPackage}}"
)

// stub{{.Name}}Client implements {{.ClientInterfaceName}} against in-memory data -- zero network
// access, mirroring the seam pkg/scope's IdentityClient/RegionClient already establish.
type stub{{.Name}}Client struct {
	items   []{{.SDKPackage}}.{{.SDKType}}
	deleted []string
	listErr error
}

// {{.ListMethod}}/{{.DeleteMethod}} signatures below must match the real
// {{.SDKPackage}}.{{.SDKType}} client's methods exactly (request struct by value, not a
// pointer) to satisfy {{.ClientInterfaceName}} -- see resources_test's fakeIdentityClient for
// this project's established precedent.
func (s *stub{{.Name}}Client) {{.ListMethod}}(
	_ context.Context,
	_ {{.SDKPackage}}.{{.ListMethod}}Request,
) ({{.SDKPackage}}.{{.ListMethod}}Response, error) {
	if s.listErr != nil {
		return {{.SDKPackage}}.{{.ListMethod}}Response{}, s.listErr
	}
	return {{.SDKPackage}}.{{.ListMethod}}Response{Items: s.items}, nil
}

func (s *stub{{.Name}}Client) {{.DeleteMethod}}(
	_ context.Context,
	req {{.SDKPackage}}.{{.DeleteMethod}}Request,
) ({{.SDKPackage}}.{{.DeleteMethod}}Response, error) {
	s.deleted = append(s.deleted, *req.{{.DeleteIDField}})
	return {{.SDKPackage}}.{{.DeleteMethod}}Response{}, nil
}

// Test{{.Name}}Lister_List proves {{.ListHelperName}} returns exactly one resource, wrapping
// the stub's single item, without ever constructing a real {{.ClientAccessor}} client.
func Test{{.Name}}Lister_List(t *testing.T) {
	id := "ocid1.test.oc1..id"
	compartmentID := "ocid1.compartment.oc1..id"

	stub := &stub{{.Name}}Client{
		items: []{{.SDKPackage}}.{{.SDKType}}{
			{Id: &id, CompartmentId: &compartmentID, {{.LifecycleField}}: {{index .LifecyclePresentConsts 0}}},
		},
	}

	got, err := {{.ListHelperName}}(context.Background(), stub, compartmentID)
	if err != nil {
		t.Fatalf("{{.ListHelperName}}() error = %v, want nil", err)
	}
	if len(got) != 1 {
		t.Fatalf("{{.ListHelperName}}() returned %d resources, want 1", len(got))
	}
	if props := got[0].(*{{.Name}}).Properties(); props.Get("id") != id {
		t.Fatalf("Properties()[%q] = %q, want %q", "id", props.Get("id"), id)
	}
}

// Test{{.Name}}_Filter is the fault-injection test PITFALLS.md Pitfall 4 requires for every
// protective Filter(): every declared "present" state must return nil, and any other state must
// exclude -- this is exactly the test that catches an inverted-polarity bug before it ships.
func Test{{.Name}}_Filter(t *testing.T) {
	present := []{{.SDKPackage}}.{{.LifecycleEnumType}}{ {{range $i, $c := .LifecyclePresentConsts}}{{if $i}}, {{end}}{{$c}}{{end}} }
	for _, state := range present {
		r := &{{.Name}}{}
		r.{{.FieldName}}.{{.LifecycleField}} = state
		if err := r.Filter(); err != nil {
			t.Errorf("Filter() with present state %s = %v, want nil", state, err)
		}
	}

	other := &{{.Name}}{}
	other.{{.FieldName}}.{{.LifecycleField}} = {{.SDKPackage}}.{{.LifecycleEnumType}}("SOME_OTHER_STATE")
	if err := other.Filter(); err == nil {
		t.Error("Filter() with a non-present state = nil, want error")
	}
}

// Test{{.Name}}_Remove proves the SDK delete call fires with the right parameter, against a
// client that never touches the network.
func Test{{.Name}}_Remove(t *testing.T) {
	id := "ocid1.test.oc1..id"
	compartmentID := "ocid1.compartment.oc1..id"
	timeCreated := common.SDKTime{Time: time.Now()}

	stub := &stub{{.Name}}Client{}
	r := &{{.Name}}{client: stub}
	r.{{.FieldName}}.Id = &id
	r.{{.FieldName}}.CompartmentId = &compartmentID
	r.{{.FieldName}}.{{.LifecycleField}} = {{index .LifecyclePresentConsts 0}}
	r.{{.FieldName}}.TimeCreated = &timeCreated

	if err := r.Remove(context.Background()); err != nil {
		t.Fatalf("Remove() error = %v, want nil", err)
	}
	if len(stub.deleted) != 1 || stub.deleted[0] != id {
		t.Fatalf("stub.deleted = %v, want [%s]", stub.deleted, id)
	}
}
{{end}}
